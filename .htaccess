# Juliane Alves Clinic - configuracao para Hostinger (Apache/LiteSpeed)

# O deploy via Git deixa a pasta .git dentro da public_html: bloqueia o acesso
RedirectMatch 404 /\.git

# HTTPS: ative pelo hPanel (Seguranca -> SSL -> Forcar HTTPS).
# Se preferir forcar por aqui depois que o SSL estiver ativo, descomente:
# RewriteEngine On
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Cache de arquivos estaticos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# Compressao
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
